{
  "version": 1,
  "base": "origin/main",
  "gates": ["test", "crap", "mutation"],
  "sources": ["**/*.cs"],
  "tests": ["**/*.Tests/**", "**/*.Test/**", "**/*.UnitTests/**"],
  "exclude": ["tools/"],
  "test": {"command": ["dotnet", "test"]},
  "crap": {
    "threshold": 12,
    "inspector": ["python", "tools/referee/inspectors/csharp.py", "functions"]
  },
  "mutation": {
    "kill_rate_threshold": 80,
    "reach_rate_threshold": 50,
    "exclude_mutators": [],
    "equivalents_file": ".referee-equivalents.json",
    "inspector": ["python", "tools/referee/inspectors/csharp.py", "mutants"]
  }
}
